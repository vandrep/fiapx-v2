# Maven
target/
.mvn/timing.properties

# Quarkus
.quarkus/
*.war
*.jar
*.class
# o wrapper é versionado de propósito
!.mvn/wrapper/maven-wrapper.jar

# Logs e temporários
*.log
*.tmp

# macOS / metadados de zip
.DS_Store
__MACOSX/

# Ambiente local
.env

# Fixtures de carga (ticket 025): gerados por scripts/carga/gera-fixtures.sh
scripts/carga/fixtures/
scripts/carga/saida/

# Saida do trafego sintetico (ticket 093): separada da de `scripts/carga/` de proposito — saida
# de experimento medido e saida de demonstracao nao devem cair no mesmo diretorio.
scripts/saida/

# Lock de runtime do Claude Code: pid de sessao, nao configuracao
.claude/scheduled_tasks.lock

# Ferramental de agente (ticket 074): as skills sao instaladas por ferramenta externa
# e vivem na instalacao global do usuario, nao na entrega. `skills-lock.json` e o
# manifesto dessa instalacao; `.claude/skills/` sao symlinks para `.agents/skills/`.
.agents/
.claude/skills/
skills-lock.json
