<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiapx</groupId>
        <artifactId>fiapx</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiapx-notificacao</artifactId>
    <name>FIAP X :: notificacao</name>

    <dependencies>
        <!-- Health check para o depends_on: service_healthy do Compose ja vem do agregador
             (pom.xml raiz), igual aos outros dois servicos: expoe /q/health sem exigir
             borda HTTP publica nenhuma.

             Mensageria com videos (contrato em docs/contratos/mensagens.md, ticket 014). O
             conector RabbitMQ declara topologia (exchange, fila, DLQ, x-delivery-limit) via
             configuracao do canal. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-messaging-rabbitmq</artifactId>
        </dependency>

        <!-- Envio de e-mail via SMTP (MailHog no Compose). Mock automatico fora de %prod
             (io.quarkus.mailer.MockMailbox), o que dispensa um Dev Service de verdade. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-mailer</artifactId>
        </dependency>

        <!-- @Retry no adapter de I/O do SMTP (ADR 0001). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
